# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://user:password@host:5432/dbname).
# If unset, DreamHome Agent automatically initializes resilient local persistence for immediate usage.
DATABASE_URL=""

# PROPERTY_API_KEY: API key for real estate listings provider (e.g., RentCast, MLS Grid, or custom broker API).
PROPERTY_API_KEY=""

# PROPERTY_API_BASE_URL: Base URL for custom REST property provider (defaults to https://api.rentcast.io/v1 if using RentCast).
PROPERTY_API_BASE_URL=""

# RENTCAST_API_KEY: RentCast API key (https://rentcast.io) for live nationwide MLS & property records.
RENTCAST_API_KEY=""

# GEOCODING_PROVIDER: 'nominatim' (OpenStreetMap, no key required) or 'google'.
GEOCODING_PROVIDER="nominatim"

# GEOCODING_API_KEY: Required if GEOCODING_PROVIDER is set to 'google'.
GEOCODING_API_KEY=""

# MAPS_API_KEY: Optional Google Maps JS API key for satellite/street view.
MAPS_API_KEY=""

# AUTH_SECRET: Secret key used to sign session authentication tokens.
AUTH_SECRET="dreamhome-agent-super-secure-production-secret-key-32chars"

